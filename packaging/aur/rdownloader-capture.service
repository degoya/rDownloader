# rDownloader's desktop capture agent in the graphical session (RD-180-08), from the
# rdownloader-bin package. Pair it once, then enable it:
#   rdownloader-capture configure --token-stdin
#   systemctl --user enable --now rdownloader-capture
[Unit]
Description=rDownloader Capture
Documentation=https://rdownloader.net
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/rdownloader/rdownloader-capture run
Restart=on-failure
RestartSec=5
# 10: not paired yet, 11: another Click'n'Load listener holds port 9666. Neither is cured by a
# restart.
RestartPreventExitStatus=10 11

[Install]
WantedBy=graphical-session.target
