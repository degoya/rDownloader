# rDownloader's service for one user (RD-180-08), from the rdownloader-bin package:
#   systemctl --user enable --now rdownloader
# The database and the installed plugins go to ~/.local/share/rdownloader/data, the default
# download folder to ~/.local/share/rdownloader/downloads; upgrades never touch either.
[Unit]
Description=rDownloader Service
Documentation=https://rdownloader.net
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Missing on the first start: ExecStartPre creates it, and ExecStart runs in it.
WorkingDirectory=-%h/.local/share/rdownloader
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/rdownloader
ExecStart=/usr/lib/rdownloader/rdownloader serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
