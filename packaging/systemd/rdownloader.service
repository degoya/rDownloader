# rDownloader's service as a systemd user unit: the one source for the deb, rpm and AUR packages
# (RD-180-05, RD-180-08, RD-1110-07). The binary moves into the user's data folder itself
# (~/.local/share/rdownloader: data/, downloads/), because the package marks it installed, so the
# unit needs no working directory. Enable it per user:
#   systemctl --user daemon-reload
#   systemctl --user enable --now rdownloader
[Unit]
Description=rDownloader Service
Documentation=https://rdownloader.net
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/rdownloader/rdownloader serve
# Also what restarts the service when rDownloader restarts itself to apply a plugin installed or
# updated (RD-1240-32): it stops gracefully and ends with exit code 75, which on-failure restarts.
Restart=on-failure
RestartSec=5
# Hardening that holds for a user unit without a namespace of its own (audit K5). Not
# MemoryDenyWriteExecute: Wasmtime compiles the plugins to machine code at run time.
# AF_NETLINK: the address lookup and the interface list read the kernel's routing table.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# The system calls of an ordinary service; anything outside that set fails with EPERM instead of
# ending the process. Applies to the helpers it starts as well.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Kernel tunables (/proc/sys, /sys) read-only (RD-1420-05, audit L-36). In a user unit systemd
# sets this up in a user namespace of the unit's own (an implicit PrivateUsers=self: other users'
# files show as nobody, access is unchanged); where the kernel refuses unprivileged user namespaces
# systemd logs that and starts the service without the read-only mounts. Not ProtectKernelModules or
# ProtectKernelLogs: both drop a capability from the bounding set, which a user manager may not do
# (systemd 255 on Ubuntu 24.04 stops the unit with 218/CAPABILITIES); the system call filter above
# refuses module loading and the kernel log anyway. Not ProtectSystem or ProtectHome: a user cannot
# write /usr or /etc anyway, and the user picks the folders it works in.
ProtectKernelTunables=yes
# New files for the user alone, as the portable launcher does (scripts/linux/start-rdownloader.sh).
# A media server running as another user reads the downloads only with a drop-in:
#   systemctl --user edit rdownloader   ->   [Service] UMask=0022
UMask=0077

[Install]
WantedBy=default.target
