# The desktop capture agent (Click'n'Load, clipboard, .nzb files) as a systemd user unit: the one
# source for the deb, rpm and AUR packages (RD-180-05, RD-180-08, RD-1110-07). It needs a
# graphical session and a paired server:
#   rdownloader-capture configure --token-stdin   (the command Settings > Desktop client shows)
#   systemctl --user enable --now rdownloader-capture
[Unit]
Description=rDownloader Capture
Documentation=https://rdownloader.net
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/rdownloader/rdownloader-capture run
Restart=on-failure
RestartSec=5
# 10: not paired yet, 11: another Click'n'Load listener holds port 9666. Neither goes away by
# starting again.
RestartPreventExitStatus=10 11
# Hardening that holds for a user unit without a namespace of its own (audit K5). AF_UNIX is
# the session: D-Bus, the display server, the tray. AF_INET/AF_INET6 reach the service and
# hold the Click'n'Load port; AF_NETLINK serves the address lookup.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=graphical-session.target
