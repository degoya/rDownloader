# The desktop capture agent (Click'n'Load, clipboard, .nzb files) as a systemd user unit: the one
# source for the deb, rpm and AUR packages (RD-180-05, RD-180-08, RD-1110-07). It needs a
# graphical session; without a link it runs and waits on its link page (RD-1390-02):
#   systemctl --user enable --now rdownloader-capture
#   rdownloader-capture link   (opens the page; or configure --token-stdin, as Settings > Desktop shows)
[Unit]
Description=rDownloader Capture
Documentation=https://rdownloader.net
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/rdownloader/rdownloader-capture run
Restart=on-failure
RestartSec=5
# 11: another Click'n'Load listener holds port 9666, which does not go away by starting again.
RestartPreventExitStatus=11
# Hardening that holds for a user unit without a namespace of its own (audit K5). AF_UNIX is
# the session: D-Bus, the display server, the tray. AF_INET/AF_INET6 reach the service and
# hold the Click'n'Load port; AF_NETLINK serves the address lookup.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# The system calls of an ordinary service; anything outside that set fails with EPERM instead of
# ending the process. Applies to the helpers it starts as well.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Kernel tunables (/proc/sys, /sys) read-only (RD-1420-05, audit L-36). In a user unit systemd
# sets this up in a user namespace of the unit's own (an implicit PrivateUsers=self: other users'
# files show as nobody, access is unchanged); where the kernel refuses unprivileged user namespaces
# systemd logs that and starts the agent without the read-only mounts. Not ProtectKernelModules or
# ProtectKernelLogs: both drop a capability from the bounding set, which a user manager may not do
# (systemd 255 on Ubuntu 24.04 stops the unit with 218/CAPABILITIES); the system call filter above
# refuses module loading and the kernel log anyway. Not ProtectSystem or ProtectHome: a user cannot
# write /usr or /etc anyway, and the user picks the folders it works in.
ProtectKernelTunables=yes
# New files (its configuration, the link token) for the user alone, as the service's unit and the
# portable launcher (scripts/linux/start-rdownloader.sh) do.
UMask=0077

[Install]
WantedBy=graphical-session.target
