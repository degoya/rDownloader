# rDownloader for dnf (Fedora, RHEL) and zypper (openSUSE): /etc/yum.repos.d/rdownloader.repo
# Packages and metadata are signed by @FINGERPRINT@.
[rdownloader]
name=rDownloader
type=rpm-md
baseurl=@BASE_URL@/rpm
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=@BASE_URL@/rdownloader.asc
metadata_expire=6h
