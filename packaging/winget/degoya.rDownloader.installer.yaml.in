# rDownloader's winget installer manifest (RD-180-07). Rendered from
# packaging/winget/degoya.rDownloader.installer.yaml.in in @REPOSITORY@ by
# scripts/package-managers.sh and submitted to microsoft/winget-pkgs by the release workflow:
# change the template, not this file.
#
# The portable Windows ZIP, extracted as a whole into
# %LOCALAPPDATA%\Microsoft\WinGet\Packages\degoya.rDownloader_<source>\. The package folder
# goes on PATH instead of a symlink per executable (ArchiveBinariesDependOnPath): the service
# installs its bundled plugins from plugins\ beside the executable it was started as, and the
# launchers start the executables beside themselves and keep the data there, which a symlink in
# WinGet\Links would both point somewhere else. A portable package installs per user, which is
# what the service needs (it writes data\ and downloads\ into that folder); winget refuses a
# `Scope` on one, and `winget validate` fails on the warning.
# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.10.0.schema.json

PackageIdentifier: degoya.rDownloader
PackageVersion: @VERSION@
InstallerType: zip
NestedInstallerType: portable
NestedInstallerFiles:
- RelativeFilePath: rdownloader.exe
  PortableCommandAlias: rdownloader
- RelativeFilePath: rdownloader-capture.exe
  PortableCommandAlias: rdownloader-capture
ArchiveBinariesDependOnPath: true
Commands:
- rdownloader
- rdownloader-capture
Installers:
- Architecture: x64
  InstallerUrl: @BASE_URL@/rdownloader-windows-x86_64.zip
  InstallerSha256: @SHA256_WINDOWS_X86_64_UPPER@
ManifestType: installer
ManifestVersion: 1.10.0
