<?xml version="1.0"?>
<!--
  One level of a deeply nested share, as Nextcloud answers `Depth: 1` for it. The contract
  test fills three placeholders in to build a tree deeper than the walk is allowed to follow:
  this collection's own href, the one collection below it, and the number naming both.
-->
<d:multistatus xmlns:d="DAV:" xmlns:s="http://sabredav.org/ns" xmlns:oc="http://owncloud.org/ns" xmlns:nc="http://nextcloud.org/ns">
  <d:response>
    <d:href>__SELF__</d:href>
    <d:propstat>
      <d:prop>
        <d:displayname>level __LEVEL__</d:displayname>
        <d:resourcetype>
          <d:collection/>
        </d:resourcetype>
      </d:prop>
      <d:status>HTTP/1.1 200 OK</d:status>
    </d:propstat>
    <d:propstat>
      <d:prop>
        <d:getcontentlength/>
      </d:prop>
      <d:status>HTTP/1.1 404 Not Found</d:status>
    </d:propstat>
  </d:response>
  <d:response>
    <d:href>__CHILD__</d:href>
    <d:propstat>
      <d:prop>
        <d:displayname>deeper</d:displayname>
        <d:resourcetype>
          <d:collection/>
        </d:resourcetype>
      </d:prop>
      <d:status>HTTP/1.1 200 OK</d:status>
    </d:propstat>
  </d:response>
  <d:response>
    <d:href>__SELF__note__LEVEL__.txt</d:href>
    <d:propstat>
      <d:prop>
        <d:displayname>note__LEVEL__.txt</d:displayname>
        <d:getcontentlength>1024</d:getcontentlength>
        <d:resourcetype/>
      </d:prop>
      <d:status>HTTP/1.1 200 OK</d:status>
    </d:propstat>
  </d:response>
</d:multistatus>
