# The Python tools of the container image (docker/Dockerfile), one `name==version` each. Not
# installed from here: scripts/docker-tools.sh --lock compiles docker/requirements.txt from it,
# every dependency pinned with its hashes, and the image installs that with --require-hashes
# (RD-191-09). `scripts/docker-tools.sh --bump` moves every line to the newest release first.
# yt-dlp in particular ages fast; the running versions are visible under Settings -> External
# tools, and a newer one can be dropped into /config/vendor.
yt-dlp==2026.8.19
streamlink==8.5.0
gallery-dl==1.32.11
