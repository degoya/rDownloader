# Every text file is LF in the repository and in every checkout, Windows included: sqlx checksums
# each migration's bytes, and tests compare sources and fixtures byte for byte. A Windows runner's
# core.autocrlf=true would otherwise check out CRLF.
* text=auto eol=lf

# cmd.exe mis-parses `call :label` in a batch file with LF line ends.
*.bat text eol=crlf
*.cmd text eol=crlf

# Recorded pages and responses stay byte for byte as captured, mixed line ends included.
**/tests/fixtures/** -text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.xz binary
*.7z binary
*.rar binary
*.wasm binary
*.rdplug binary
*.torrent binary
*.dlc binary

# Merge drivers (RD-1100-13): the rd-* ones are scripts/lib/merge-drivers/, registered by
# scripts/integrate.sh; without that registration git merges them as text. CHANGELOG.md by
# section (RD-1220-01): git's union put a branch's new entries into the section a release had made
# of [Unreleased] meanwhile; the driver keeps them under [Unreleased].
CHANGELOG.md merge=rd-changelog
# The job indexes: conflicts of table rows from both sides, then archive-jobs.sh keeps one row per
# job where its file lies (RD-1220-01).
docs/roadmap/jobs/README.md merge=rd-jobindex
docs/roadmap/jobs/archive/README.md merge=rd-jobindex
# A plugin's release notes the same way: two branches raising one plugin to the same version both
# add its section, and plugin-release-notes.sh --check names the second one to fold in.
plugins/*/CHANGES.md merge=union
# The application's release notes too (RD-1150-02); release-notes.sh --check names a second
# section of one version.
RELEASE-NOTES.md merge=union
crates/rd-db/migrations.sha384 merge=rd-pins
web/src/locales/**/*.json merge=rd-json
